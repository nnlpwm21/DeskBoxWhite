<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19044.0</SupportedOSPlatformVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>../../src/DeskBoxWhite/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <Compile Include="../../src/DeskBoxWhite/Services/NativeAppNotificationService.cs" Link="NativeAppNotificationService.cs" />
    <Compile Include="../../src/DeskBoxWhite/Services/NativeNotificationActivationBootstrap.cs" Link="NativeNotificationActivationBootstrap.cs" />
    <Compile Include="../../src/DeskBoxWhite/Services/NativeNotificationActivationEnvelopeStore.cs" Link="NativeNotificationActivationEnvelopeStore.cs" />
  </ItemGroup>
</Project>
